{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "market-outcomes/<market>-v<K>.json",
  "description": "Generated by the validator. The object a prediction-market admin reads at a snapshot tag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market",
    "contractVersion",
    "contractStatus",
    "resolutionSource",
    "title",
    "outcomes",
    "evidenceCutoff",
    "windowCloses",
    "outcome",
    "reason",
    "attempts"
  ],
  "properties": {
    "market": {
      "type": "string",
      "pattern": "^market-\\d{2}$"
    },
    "contractVersion": {
      "type": "integer"
    },
    "contractStatus": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "resolutionSource": {
      "type": "boolean"
    },
    "outcomes": {
      "type": "array"
    },
    "evidenceCutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "windowCloses": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "outcome": {
      "enum": [
        "YES",
        "NO",
        "OTHER"
      ]
    },
    "reason": {
      "enum": [
        "qualifying-attempt-met-bars",
        "every-qualifying-attempt-missed-bars",
        "no-qualifying-attempt"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "attemptType",
          "qualifying",
          "barsMet",
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "bars-met",
              "substantive-bar-failed",
              "reporting-insufficient",
              "late-evidence",
              "late-filing",
              "qualification-failed",
              "judged-not-qualifying",
              "unresolved-judgment"
            ]
          }
        }
      }
    },
    "title": {
      "type": "string"
    }
  }
}
