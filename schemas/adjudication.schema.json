{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adjudication/<market>/<attempt-id>.yaml",
  "description": "Maintainer-only. One verdict per human check the contract and the shared rules name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt",
    "market",
    "contractVersion",
    "maintainer",
    "decidedAt",
    "checks"
  ],
  "properties": {
    "attempt": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "pattern": "^market-\\d{2}$"
    },
    "contractVersion": {
      "type": "integer"
    },
    "maintainer": {
      "type": "string"
    },
    "decidedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "note"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unsettled"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
